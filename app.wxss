page {
  background: #f7f7f7;
  color: #111827;
  font-size: 28rpx;
}

.container {
  padding: 24rpx 24rpx 140rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.muted {
  color: #6b7280;
}

.accent {
  color: #c7a46a;
}

.btn {
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.btn-primary {
  background: #c7a46a;
  color: #ffffff;
}

.btn-ghost {
  background: #f3f4f6;
  color: #111827;
}

.chip {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e7eb;
  color: #374151;
  background: #ffffff;
  font-size: 26rpx;
}

.chip-active {
  border-color: #c7a46a;
  color: #c7a46a;
  background: rgba(199, 164, 106, 0.08);
}

