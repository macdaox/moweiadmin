.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #ffffff;
  border-top: 2rpx solid #f3f4f6;
}

.tabbar-inner {
  display: flex;
  height: 120rpx;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b7280;
}

.item.active {
  color: #c7a46a;
}

.icon {
  font-size: 36rpx;
  line-height: 40rpx;
}

.text {
  font-size: 22rpx;
  line-height: 28rpx;
  margin-top: 6rpx;
}

