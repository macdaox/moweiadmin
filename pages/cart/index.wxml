<view class="container">
  <view class="empty" wx:if="{{items.length===0}}">
    <text class="muted">购物车还是空的</text>
    <view class="btn btn-primary go" bindtap="goShop">去逛逛</view>
  </view>

  <view wx:else>
    <view class="card list">
      <view class="row" wx:for="{{items}}" wx:key="key">
        <image class="img" mode="aspectFill" src="{{item.cover}}" />
        <view class="mid">
          <text class="name">{{item.title}}</text>
          <text class="muted sku">{{item.skuName}}</text>
          <text class="price">¥{{item.price}}</text>
        </view>
        <view class="right">
          <view class="step">
            <view class="step-btn" bindtap="dec" data-id="{{item.id}}" data-skuid="{{item.skuId}}">-</view>
            <text class="step-num">{{item.qty}}</text>
            <view class="step-btn" bindtap="inc" data-id="{{item.id}}" data-skuid="{{item.skuId}}">+</view>
          </view>
          <text class="del" bindtap="del" data-id="{{item.id}}" data-skuid="{{item.skuId}}">删除</text>
        </view>
      </view>
    </view>

    <view class="bar">
      <view>
        <text class="muted">合计</text>
        <text class="total">¥{{total}}</text>
      </view>
      <view class="btn btn-primary pay" bindtap="checkout">去结算</view>
    </view>
  </view>
</view>

