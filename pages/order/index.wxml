<view class="container">
  <view class="card block">
    <text class="title">收货/联系信息</text>
    <view class="form">
      <view class="field">
        <text class="label muted">姓名</text>
        <input class="ipt" value="{{name}}" placeholder="请输入" bindinput="onName" />
      </view>
      <view class="field">
        <text class="label muted">电话</text>
        <input class="ipt" value="{{phone}}" placeholder="请输入" type="number" bindinput="onPhone" />
      </view>
      <view class="field">
        <text class="label muted">地址</text>
        <input class="ipt" value="{{address}}" placeholder="请输入" bindinput="onAddress" />
      </view>
      <view class="field">
        <text class="label muted">备注</text>
        <input class="ipt" value="{{note}}" placeholder="可选" bindinput="onNote" />
      </view>
    </view>
  </view>

  <view class="card block" wx:if="{{items.length>0}}">
    <text class="title">商品清单</text>
    <view class="ol">
      <view class="li" wx:for="{{items}}" wx:key="key">
        <view class="li-left">
          <text class="name">{{item.title}}</text>
          <text class="muted sku">{{item.skuName}} × {{item.qty}}</text>
        </view>
        <text class="price">¥{{item.subtotal}}</text>
      </view>
    </view>
  </view>

  <view class="bar">
    <view>
      <text class="muted">合计</text>
      <text class="total">¥{{total}}</text>
    </view>
    <view class="btn btn-primary submit" bindtap="submit">提交订单</view>
  </view>
</view>

