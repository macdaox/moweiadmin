.head {
  padding: 22rpx 18rpx;
}

.shop {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
}

.block {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
}

.row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid #f3f4f6;
}

.row:first-child {
  border-top: 0;
}

.label {
  width: 92rpx;
}

.val {
  flex: 1;
  color: #111827;
}

.actions {
  margin-top: 18rpx;
  display: grid;
  gap: 14rpx;
}

.u {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.u-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
}

.u-name {
  color: #374151;
  font-size: 26rpx;
}

.gate {
  margin-top: 16rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 0;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 26rpx 22rpx 34rpx;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.sheet-desc {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.field {
  margin-top: 18rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 2rpx solid #f3f4f6;
}

.f-label {
  width: 92rpx;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
}

.avatar-ph {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.nick-input {
  flex: 1;
  text-align: right;
  color: #111827;
  font-size: 28rpx;
}

.sheet-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.sheet-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-btn.ghost {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  color: #374151;
}

.sheet-btn.primary {
  background: #c7a46a;
  color: #ffffff;
}
