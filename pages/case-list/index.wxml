<view class="container">
  <view class="head card">
    <text class="title">{{title}}</text>
    <text class="muted sub">点击卡片进入图集详情，可左右滑动预览</text>
  </view>

  <view class="list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="item card"
      data-id="{{item.id}}"
      data-type="{{type}}"
      bindtap="goDetail"
    >
      <image class="img" mode="aspectFill" src="{{item.cover}}" />
      <view class="info">
        <text class="name">{{item.title}}</text>
        <text class="muted meta">{{item.count}} 张图片</text>
      </view>
    </view>
  </view>
</view>

