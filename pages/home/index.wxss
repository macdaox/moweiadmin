.search {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
}

.search-btn {
  color: #c7a46a;
  font-weight: 600;
  padding-left: 16rpx;
}

.section {
  margin-top: 20rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 6rpx 6rpx 12rpx;
}

.sub {
  display: block;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.more {
  font-size: 26rpx;
  color: #c7a46a;
}

.cats {
  width: 100%;
}

.cats-inner {
  display: flex;
  padding: 6rpx;
}

.cat {
  width: 150rpx;
  padding: 18rpx 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon {
  font-size: 44rpx;
}

.cat-name {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: #374151;
}

.case-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.case-card {
  overflow: hidden;
}

.case-img {
  width: 100%;
  height: 240rpx;
}

.case-foot {
  padding: 14rpx 14rpx 16rpx;
}

.case-tag {
  font-size: 24rpx;
  color: #c7a46a;
}

.design {
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.design-img {
  width: 100%;
  height: 320rpx;
}

.products {
  width: 100%;
}

.products-inner {
  display: flex;
  padding: 6rpx;
}

.p-card {
  width: 280rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.p-img {
  width: 280rpx;
  height: 280rpx;
}

.p-info {
  padding: 14rpx;
}

.p-title {
  font-size: 26rpx;
  color: #111827;
  display: block;
  height: 72rpx;
}

.p-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #c7a46a;
  margin-top: 8rpx;
  display: block;
}

.float {
  position: fixed;
  right: 18rpx;
  bottom: 170rpx;
  z-index: 998;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 26rpx rgba(17, 24, 39, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0;
}

.contact {
  line-height: 88rpx;
}

.float-ico {
  font-size: 34rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.badge-t {
  color: #ffffff;
  font-size: 20rpx;
  line-height: 20rpx;
}
