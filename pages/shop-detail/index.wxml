<view class="container">
  <view wx:if="{{product}}">
    <view class="card hero">
      <swiper class="swiper" autoplay="true" circular="true" interval="3500">
        <swiper-item wx:for="{{product.images}}" wx:key="*this">
          <image class="hero-img" mode="aspectFill" src="{{item}}" bindtap="previewImage" data-src="{{item}}" />
        </swiper-item>
      </swiper>
    </view>

    <view class="card block">
      <text class="p-title">{{product.title}}</text>
      <text class="p-price">¥{{activePrice}}</text>
    </view>

    <view class="card block">
      <view class="row">
        <text class="label muted">规格</text>
        <view class="chips">
          <view
            wx:for="{{product.skus}}"
            wx:key="id"
            class="chip {{selectedSkuId===item.id?'chip-active':''}}"
            data-id="{{item.id}}"
            bindtap="selectSku"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <view class="row qty">
        <text class="label muted">数量</text>
        <view class="step">
          <view class="step-btn" bindtap="decQty">-</view>
          <text class="step-num">{{qty}}</text>
          <view class="step-btn" bindtap="incQty">+</view>
        </view>
      </view>
    </view>

    <view class="card block">
      <text class="muted">服务说明</text>
      <view class="desc">
        <text>• 支持线上询价与预约上门量尺</text>
        <text>• 具体报价以现场测量与设计为准</text>
        <text>• 点击图片可放大预览</text>
      </view>
    </view>

    <view class="bar">
      <view class="bar-left" bindtap="toggleFav">
        <text class="fav">{{isFav ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="bar-btn ghost" bindtap="addCart">加入购物车</view>
      <view class="bar-btn primary" bindtap="buyNow">立即下单</view>
    </view>
  </view>

  <view wx:else class="card empty">
    <text class="empty-title">商品加载失败</text>
    <text class="muted">{{loadError || '请返回重试'}}</text>
    <view class="empty-actions">
      <view class="btn btn-ghost" bindtap="goBack">返回上一页</view>
      <view class="btn btn-primary" bindtap="goHome">去首页</view>
    </view>
  </view>
</view>
