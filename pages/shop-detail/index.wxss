.hero {
  overflow: hidden;
}

.swiper {
  height: 420rpx;
}

.hero-img {
  width: 100%;
  height: 420rpx;
}

.block {
  margin-top: 16rpx;
  padding: 18rpx 18rpx 22rpx;
}

.p-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
}

.p-price {
  margin-top: 12rpx;
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #c7a46a;
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.label {
  width: 84rpx;
  padding-top: 10rpx;
}

.chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.qty {
  margin-top: 18rpx;
  align-items: center;
}

.step {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.step-num {
  width: 72rpx;
  text-align: center;
  font-size: 30rpx;
}

.desc text {
  display: block;
  margin-top: 10rpx;
  color: #374151;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #f3f4f6;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.bar-left {
  width: 120rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(17, 24, 39, 0.06);
}

.fav {
  font-size: 26rpx;
  color: #c7a46a;
  font-weight: 600;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
}

.ghost {
  background: #f3f4f6;
  color: #111827;
}

.primary {
  background: #c7a46a;
  color: #ffffff;
}

.empty {
  margin-top: 16rpx;
  padding: 44rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.empty-actions {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.empty-actions .btn {
  flex: 1;
}
