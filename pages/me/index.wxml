<view class="container">
  <view class="card head">
    <text class="u">访客</text>
    <text class="muted">演示版：订单/收藏/咨询记录保存到本地</text>
  </view>

  <view class="card block">
    <view class="kv">
      <text class="k muted">订单</text>
      <text class="v">{{orders.length}}</text>
    </view>
    <view class="kv">
      <text class="k muted">收藏</text>
      <text class="v">{{favorites.length}}</text>
    </view>
    <view class="kv">
      <text class="k muted">咨询</text>
      <text class="v">{{consults.length}}</text>
    </view>
  </view>

  <view class="card block" wx:if="{{orders.length}}">
    <text class="title">最近订单</text>
    <view class="ol">
      <view wx:for="{{orders}}" wx:key="id" class="li">
        <view class="li-left">
          <text class="oid">{{item.id}}</text>
          <text class="muted">{{item.status}} · ¥{{item.totalPrice}}</text>
        </view>
        <text class="muted">{{item.createdAt}}</text>
      </view>
    </view>
  </view>

  <view class="card block" wx:if="{{favorites.length}}">
    <text class="title">我的收藏</text>
    <view class="tags">
      <view wx:for="{{favorites}}" wx:key="key" class="tag">{{item.type}} · {{item.id}}</view>
    </view>
  </view>

  <view class="card block" wx:if="{{consults.length}}">
    <text class="title">咨询记录</text>
    <view class="ol">
      <view wx:for="{{consults}}" wx:key="id" class="li">
        <view class="li-left">
          <text class="oid">{{item.title}}</text>
          <text class="muted">{{item.createdAt}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="actions">
    <view class="btn btn-primary" bindtap="goShop">继续逛商城</view>
    <button class="btn btn-ghost" open-type="contact">在线客服</button>
  </view>
</view>
