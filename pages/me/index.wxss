.head {
  padding: 18rpx 18rpx 20rpx;
}

.u {
  font-size: 34rpx;
  font-weight: 800;
  display: block;
}

.block {
  margin-top: 16rpx;
  padding: 18rpx 18rpx 22rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 2rpx solid #f3f4f6;
}

.kv:first-child {
  border-top: 0;
}

.v {
  font-size: 34rpx;
  font-weight: 900;
  color: #c7a46a;
}

.ol {
  margin-top: 14rpx;
}

.li {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 2rpx solid #f3f4f6;
}

.li:first-child {
  border-top: 0;
}

.li-left {
  flex: 1;
}

.oid {
  display: block;
  font-weight: 800;
  color: #111827;
}

.tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.04);
  color: #374151;
  font-size: 24rpx;
}

.actions {
  margin-top: 18rpx;
  display: grid;
  gap: 14rpx;
}

