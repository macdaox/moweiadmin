.wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: #0b0f19;
}

.swiper {
  height: 100vh;
}

.img {
  width: 100%;
  height: 100vh;
}

.hud {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 18rpx 34rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.hud-left {
  flex: 1;
}

.name {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.hud-left .muted {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hud-btn {
  width: 140rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hud-fav {
  color: #ffffff;
  font-size: 26rpx;
}

.empty {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 72rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.empty-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-sub {
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}
