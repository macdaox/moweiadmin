<view class="container">
  <view class="card head">
    <text class="title">装修动态</text>
    <text class="muted">图文动态展示（本地模拟点赞/评论）</text>
  </view>

  <view class="list">
    <view wx:for="{{posts}}" wx:key="id" wx:for-item="post" class="card post">
      <text class="p-title">{{post.title}}</text>
      <text class="p-content muted">{{post.content}}</text>

      <view class="imgs" wx:if="{{post.images.length}}">
        <image
          wx:for="{{post.images}}"
          wx:key="*this"
          wx:for-item="img"
          class="img"
          mode="aspectFill"
          src="{{img}}"
          data-pid="{{post.id}}"
          data-src="{{img}}"
          bindtap="preview"
        />
      </view>

      <view class="actions">
        <view class="act" data-id="{{post.id}}" bindtap="toggleLike">
          <text class="act-ico">{{post.liked ? '❤️' : '🤍'}}</text>
          <text class="act-t">赞 {{post.likes}}</text>
        </view>
        <button class="act" open-type="contact">
          <text class="act-ico">💬</text>
          <text class="act-t">咨询</text>
        </button>
      </view>

      <view class="comments" wx:if="{{post.comments.length}}">
        <view wx:for="{{post.comments}}" wx:key="id" wx:for-item="c" class="c">
          <text class="c-name">{{c.name}}：</text>
          <text class="c-text">{{c.text}}</text>
        </view>
      </view>

      <view class="input">
        <input
          class="ipt"
          placeholder="写评论..."
          value="{{draft[post.id] || ''}}"
          data-id="{{post.id}}"
          bindinput="onDraft"
          confirm-type="send"
          bindconfirm="send"
        />
        <text class="send" data-id="{{post.id}}" bindtap="send">发送</text>
      </view>
    </view>
  </view>
</view>
