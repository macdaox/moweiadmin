.head {
  padding: 18rpx 18rpx 20rpx;
}

.list {
  margin-top: 16rpx;
  display: grid;
  gap: 16rpx;
}

.post {
  padding: 18rpx 18rpx 20rpx;
}

.p-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.p-content {
  display: block;
  margin-top: 10rpx;
}

.imgs {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.img {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.act {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0;
}

.act-ico {
  font-size: 30rpx;
}

.act-t {
  font-size: 26rpx;
  color: #111827;
}

.comments {
  margin-top: 14rpx;
  padding: 14rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.03);
}

.c {
  display: flex;
  gap: 6rpx;
  padding: 6rpx 0;
}

.c-name {
  font-weight: 700;
  color: #374151;
}

.c-text {
  color: #374151;
}

.input {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #f3f4f6;
}

.ipt {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  padding: 0 16rpx;
}

.send {
  color: #c7a46a;
  font-weight: 700;
}

